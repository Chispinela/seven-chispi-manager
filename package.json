{
  "name": "seven-chispi-manager",
  "version": "1.0.5",
  "description": "Seven Chispi Manager — 7 Days to Die server management",
  "main": "src/main.cjs",
  "author": "Chispi",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "build": "electron-builder --win nsis portable",
    "screenshots": "node tools/capture-screenshots.cjs --packaged"
  },
  "dependencies": {
    "adm-zip": "0.6.1",
    "discord.js": "14.28.0",
    "fast-xml-parser": "5.11.2",
    "nodemailer": "10.3.1"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.0.12",
    "jsdom": "^30.1.3",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "com.chispi.sevenmanager",
    "productName": "Seven Chispi Manager",
    "directories": {
      "output": "output/1.0.5"
    },
    "files": [
      "src/**/*",
      "ui/**/*",
      "assets/**/*",
      "docs/FEATURES.md",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Seven Chispi Manager",
      "artifactName": "Seven-Chispi-Manager-Setup-${version}.${ext}",
      "installerLanguages": [
        "es_ES",
        "en_US",
        "pt_PT",
        "zh_CN",
        "ja_JP",
        "ru_RU"
      ]
    },
    "portable": {
      "artifactName": "Seven-Chispi-Manager-Portable-${version}.${ext}"
    },
    "asar": false,
    "afterPack": "tools/after-pack.cjs"
  },
  "homepage": "https://github.com/Chispinela/seven-chispi-manager",
  "repository": {
    "type": "git",
    "url": "https://github.com/Chispinela/seven-chispi-manager.git"
  },
  "bugs": {
    "url": "https://github.com/Chispinela/seven-chispi-manager/issues"
  }
}
